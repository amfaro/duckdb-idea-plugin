<idea-plugin>
    <id>com.amfaro.duckdb</id>
    <name>DuckDB</name>
    <vendor url="https://github.com/amfaro">amfaro</vendor>

    <!-- description is injected at build time from README.md (see build.gradle.kts pluginConfiguration). -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- preload forces init before the sql.dialect EP is resolved, ensuring Dbms.DUCKDB is registered in time -->
        <applicationService serviceImplementation="com.amfaro.duckdb.DuckDbPlugin" preload="true"/>
        <sql.dialect dbms="DUCKDB"
                     implementationClass="com.amfaro.duckdb.dialect.DuckDbSqlDialect"/>
        <database.dialect dbms="DUCKDB"
                          implementationClass="com.amfaro.duckdb.dialect.DuckDbDatabaseDialect"/>
        <lang.parserDefinition language="DuckDB"
                               implementationClass="com.amfaro.duckdb.dialect.DuckDbParserDefinition"/>
        <lang.syntaxHighlighterFactory language="DuckDB"
                                       implementationClass="com.amfaro.duckdb.dialect.DuckDbSyntaxHighlighterFactory"/>
    </extensions>
</idea-plugin>
